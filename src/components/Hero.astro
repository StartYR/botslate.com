---
import Button from './Button.astro';
import Badge from './Badge.astro';
import { resolvePath } from '../utils/navigation';
---

<section class="relative pt-28 pb-28 lg:pt-44 lg:pb-36 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-white dark:bg-[#09090b]">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgwLDAsMCwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] dark:bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCI+CjxyZWN0IHdpZHRoPSIyNCIgaGVpZ2h0PSIyNCIgZmlsbD0ibm9uZSI+PC9yZWN0Pgo8Y2lyY2xlIGN4PSIxIiBjeT0iMSIgcj0iMSIgZmlsbD0icmdiYSgyNTUsMjU1LDI1NSwwLjA1KSI+PC9jaXJjbGU+Cjwvc3ZnPg==')] [mask-image:linear-gradient(to_bottom,white,transparent)]"></div>
    <div class="absolute top-0 right-0 -translate-y-12 translate-x-1/3 w-[800px] h-[600px] bg-primary-400/20 dark:bg-primary-900/30 rounded-full blur-[120px] opacity-80 mix-blend-multiply dark:mix-blend-screen animate-pulse"></div>
    <div class="absolute bottom-0 left-0 translate-y-1/3 -translate-x-1/3 w-[600px] h-[500px] bg-accent-400/20 dark:bg-accent-900/30 rounded-full blur-[100px] opacity-80 mix-blend-multiply dark:mix-blend-screen"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
    <div class="flex justify-center mb-8">
      <Badge variant="primary" class="px-4 py-1.5 text-sm border border-primary-200 dark:border-primary-800 backdrop-blur-md bg-white/50 dark:bg-primary-900/50">
        <span aria-hidden="true" class="mr-2">🚀</span> Independent software lab
      </Badge>
    </div>

    <h1 class="text-6xl sm:text-7xl lg:text-8xl font-heading font-extrabold tracking-tight text-slate-900 dark:text-white mb-8 max-w-5xl mx-auto leading-[1.1]">
      Ideas, tools, and <span class="text-gradient">experiments.</span>
    </h1>

    <p class="text-xl sm:text-2xl text-slate-600 dark:text-slate-400 mb-12 max-w-3xl mx-auto leading-relaxed">
      A small independent space for software experiments, useful tools, and technical notes.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
      <Button href={resolvePath('/blog/')} variant="primary" size="lg" class="w-full sm:w-auto text-lg px-8 py-4 shadow-xl shadow-primary-500/20">
        Explore Notes
      </Button>
      <Button href={resolvePath('/changelog/')} variant="outline" size="lg" class="w-full sm:w-auto text-lg px-8 py-4 bg-white/50 dark:bg-slate-900/50 backdrop-blur-sm">
        View Changelog
      </Button>
    </div>

    <div class="relative mx-auto max-w-5xl reveal-on-scroll" style="transition-delay: 200ms;">
      <div class="rounded-3xl bg-slate-950 dark:bg-[#111116] shadow-2xl border border-slate-800 overflow-hidden text-left hover-glow">
        <div class="flex items-center justify-between px-5 py-4 border-b border-slate-800">
          <div class="flex gap-2" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
          </div>
          <span class="font-mono text-xs text-slate-500">botslate / index</span>
        </div>
        <div class="relative p-6 sm:p-10 lg:p-12">
          <div class="absolute inset-0 bg-[linear-gradient(to_right,#4f4f4f24_1px,transparent_1px),linear-gradient(to_bottom,#4f4f4f24_1px,transparent_1px)] bg-[size:24px_24px]"></div>
          <div class="relative grid gap-4 md:grid-cols-3">
            <div class="rounded-2xl border border-primary-400/20 bg-primary-500/10 p-6">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-primary-300">Explore</span>
              <h2 class="mt-4 text-xl font-heading font-bold text-white">Working ideas</h2>
              <p class="mt-2 text-sm leading-6 text-slate-400">Small experiments shaped by building and learning.</p>
            </div>
            <div class="rounded-2xl border border-accent-400/20 bg-accent-500/10 p-6">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-accent-300">Make</span>
              <h2 class="mt-4 text-xl font-heading font-bold text-white">Useful tools</h2>
              <p class="mt-2 text-sm leading-6 text-slate-400">Focused software for practical, well-defined needs.</p>
            </div>
            <div class="rounded-2xl border border-slate-600/60 bg-slate-900/80 p-6">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-slate-400">Record</span>
              <h2 class="mt-4 text-xl font-heading font-bold text-white">Technical notes</h2>
              <p class="mt-2 text-sm leading-6 text-slate-400">Implementation details and lessons worth keeping.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="absolute -top-12 -left-12 -z-10 w-96 h-96 bg-primary-500/30 rounded-full mix-blend-multiply dark:mix-blend-screen blur-[100px]"></div>
      <div class="absolute -bottom-12 -right-12 -z-10 w-96 h-96 bg-accent-500/30 rounded-full mix-blend-multiply dark:mix-blend-screen blur-[100px]"></div>
    </div>
  </div>
</section>
