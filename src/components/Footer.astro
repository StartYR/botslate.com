---
import BrandMark from './BrandMark.astro';
import { BRAND_NAME, NAV_LINKS, REPOSITORY_URL, SITE_DESCRIPTION } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="bg-white dark:bg-[#09090b] border-t border-slate-200 dark:border-slate-800 py-12 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-md">
        <a href={resolvePath('/')} class="group inline-flex items-center gap-2 mb-4" aria-label="Botslate home">
          <BrandMark />
          <span class="font-heading font-bold text-xl text-slate-900 dark:text-white">{BRAND_NAME}</span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-6">{SITE_DESCRIPTION}</p>
      </div>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {NAV_LINKS.map(link => (
            <li><a href={resolvePath(link.href)} class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{link.label}</a></li>
          ))}
          <li><a href={REPOSITORY_URL} class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </nav>
    </div>

    <div class="border-t border-slate-200 dark:border-slate-800 mt-10 pt-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-slate-500 dark:text-slate-400">&copy; {new Date().getFullYear()} {BRAND_NAME}</p>
      <p class="text-sm text-slate-500 dark:text-slate-400">Built with Astro.</p>
    </div>
  </div>
</footer>
